# Copy to .env and fill in. .env is gitignored; never commit real values.

# -----------------------------------------------------------------------------
# Front-end: compiled into the browser bundle at build time
# -----------------------------------------------------------------------------
# Supabase API URL as reachable from the browser. `supabase status` prints it.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Public anon key from `supabase status` — the legacy JWT-format ANON_KEY,
# not the newer PUBLISHABLE_KEY (this CLI's local Realtime server rejects
# that format for the websocket handshake: "MalformedJWT"). Safe in
# browsers; RLS enforces access. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=
# Technician app on localhost without GPS: start of the simulated route.
# Defaults to Gaur City (28.6105, 77.4320), inside the demo requests' radius.
# VITE_DEV_TECH_LAT=28.6105
# VITE_DEV_TECH_LNG=77.4320

# -----------------------------------------------------------------------------
# Redis: server-side code only (src/lib/redis.ts)
# -----------------------------------------------------------------------------
# Either REDIS_URL, or HOST/PORT/PASSWORD. REDIS_URL wins when both are set.
# Inside a container, use the service name (redis) instead of localhost.
# REDIS_URL=redis://:sewasync_local_dev@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sewasync_local_dev

# -----------------------------------------------------------------------------
# docker compose
# -----------------------------------------------------------------------------
# Host port for the web container.
WEB_PORT=8080
