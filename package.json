{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"CLIENT,ADMIN\" -c \"blue,green\" \"pnpm run dev:client\" \"pnpm run dev:admin\"",
    "dev:client": "VITE_APP_TARGET=client vite --port 3001 --strictPort",
    "dev:admin": "VITE_APP_TARGET=admin vite --port 3002 --strictPort",
    "dev:technician": "pnpm --filter technician dev",
    "dev:all": "concurrently -n \"CLIENT,ADMIN,TECH\" -c \"blue,green,magenta\" \"pnpm run dev:client\" \"pnpm run dev:admin\" \"pnpm run dev:technician\"",
    "build": "tsc && vite build",
    "build:client": "tsc && VITE_APP_TARGET=client vite build",
    "build:admin": "tsc && VITE_APP_TARGET=admin vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format": "oxfmt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "10.0.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
