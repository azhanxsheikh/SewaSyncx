{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"CLIENT,TECH,ADMIN\" -c \"blue,green,red\" \"npm run dev:client\" \"npm run dev:technician\" \"npm run dev:admin\"",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "dev:technician": "vite --config apps/technician/vite.config.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "dev:all": "concurrently -n \"CLIENT,TECH,ADMIN\" -c \"blue,green,red\" \"pnpm run dev:client\" \"pnpm run dev:technician\" \"pnpm run dev:admin\"",
    "build": "tsc && vite build --config apps/client/vite.config.ts && vite build --config apps/technician/vite.config.ts && vite build --config apps/admin/vite.config.ts",
    "build:client": "tsc && vite build --config apps/client/vite.config.ts",
    "build:technician": "tsc && vite build --config apps/technician/vite.config.ts",
    "build:admin": "tsc && vite build --config apps/admin/vite.config.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format": "oxfmt",
    "postinstall": "node scripts/patch-vite.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "10.0.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
